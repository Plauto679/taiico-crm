# Local development database
DATABASE_URL=sqlite:///./backend/taiico_local_fallback.db
TAIICO_ENV=development

# Read-only Users & Passwords workbook authentication.
# Replace with Google Workspace OAuth in a future deployment.
GOOGLE_DRIVE_USERS_FILE_ID=
AUTH_USERS_CACHE_SECONDS=300
# Leave blank for automatic HTTPS detection; production always forces Secure.
AUTH_COOKIE_SECURE=
AUTH_SESSION_IDLE_SECONDS=3600
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
# Comma-separated browser origins allowed to call FastAPI directly.
# Browser traffic normally stays same-origin through the Next.js /api proxy.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GOOGLE_DRIVE_CLIENT_EMAILS_FILE_ID=
CLIENT_EMAILS_CACHE_SECONDS=300

# Google Drive ingestion
# For local development, point this to a service account JSON file that has Viewer
# access to the configured Google Drive source folders.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/taiico-crm/local-secrets/taiico-drive-ingestion.json
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_SOURCE_COBRANZA_METLIFE_FILE_ID=
GOOGLE_DRIVE_SOURCE_COBRANZA_METLIFE_FOLDER_ID=
GOOGLE_DRIVE_SOURCE_COBRANZA_SURA_FILE_ID=
GOOGLE_DRIVE_SOURCE_COBRANZA_SURA_FOLDER_ID=
GOOGLE_DRIVE_RENEWALS_METLIFE_GMM_FOLDER_ID=
METLIFE_AGENT_PORTAL_USERNAME=
METLIFE_AGENT_PORTAL_PASSWORD=
GOOGLE_DRIVE_SOURCE_COBRANZA_AARCO_FOLDER_ID=
GOOGLE_DRIVE_SOURCE_COBRANZA_AARCO_FILE_ID=
GOOGLE_DRIVE_SOURCE_RENOVACIONES_FOLDER_ID=
GOOGLE_DRIVE_SOURCE_RENOVACIONES_AARCO_AXA_FILE_ID=
GOOGLE_DRIVE_SOURCE_RENOVACIONES_METLIFE_GMM_FILE_ID=
GOOGLE_DRIVE_SOURCE_RENOVACIONES_METLIFE_VIDA_FILE_ID=
GOOGLE_DRIVE_SOURCE_RENOVACIONES_PROMOTORIA_SURA_FILE_ID=
GOOGLE_DRIVE_SOURCE_RENOVACIONES_SURA_FILE_ID=

# SMTP email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_SENDER=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
RENEWAL_EMAIL_INTERNAL_ONLY=true
RENEWAL_EMAIL_INTERNAL_RECIPIENTS=
RENEWAL_EMAIL_CC_RECIPIENTS=alberto.alfaro@taiico.com,veronica.alfaro@taiico.com,pamela.alfaro@taiico.com
# WhatsApp Cloud API test mode. Never commit real tokens.
WHATSAPP_TEST_MODE=true
WHATSAPP_TEST_RECIPIENTS=525500000000,525511111111
WHATSAPP_TEST_ALLOWLIST=525500000000,525511111111
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=
WHATSAPP_RENEWAL_TEMPLATE_NAME=renewal_ready_test

# Canonical pending-workbook sources (Google Drive file IDs)
GOOGLE_DRIVE_PENDING_EMISION_SERVICIOS_FILE_ID=1JMr-EwtniwHvPm6zefhGJroTw2vxivmC
GOOGLE_DRIVE_PENDING_SINIESTROS_FILE_ID=1UvXo2LboTKWl5323mEuP6bmmyIhLYveL
GOOGLE_DRIVE_PENDING_DOCUMENTS_FOLDER_ID=1IIIgHB8SlEIZr5vSAuly14NJMO50ke1b
PENDING_SOURCES_CACHE_SECONDS=300

# Optional overrides. When omitted, private keys are generated under local-secrets/.
AUTH_SESSION_SECRET=
MAIL_CREDENTIALS_ENCRYPTION_KEY=
# Recluta source workbook and prospect document root in Google Drive.
GOOGLE_DRIVE_RECLUTA_SOURCE_FILE_ID=1a4YYy-vF4pESre60BJWXwdp_1DdSmObT
GOOGLE_DRIVE_RECLUTA_DOCUMENTS_FOLDER_ID=1you3U-LTCi8iVbT_GX8zC7cpT44atKpr
