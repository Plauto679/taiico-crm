# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
local-secrets/
backend/local-secrets/
backend/local-data/

# python
__pycache__/
*.py[cod]

# local databases and backups
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.backup-*.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.runtime/

# env files (can opt-in for committing if needed)
.env*
!.env.example
!backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Isolated frontend build for release validation
/.next-plauto/

# Local validation builds and generated business artifacts
/.next-contact-campaign/
/.next-renewals-mobile/
/output/
/outputs/
/tmp/

# node modules backups
node_modules_viejo/

# build outputs
/dist/
